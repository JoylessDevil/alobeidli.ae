---
import BaseLayout from "../../layouts/BaseLayout.astro";import Header from "../../components/Header.astro";import WindowHeader from "../../components/WindowHeader.astro";const base=import.meta.env.BASE_URL;const modules=import.meta.glob("./*.md",{eager:true});const posts=Object.entries(modules).map(([p,m])=>({...m.frontmatter,url:`${base}blog/${p.split('/').pop().replace('.md','')}/`})).sort((a,b)=>new Date(b.date)-new Date(a.date));
---
<BaseLayout title="Blog | Abdalla"><Header/><main class="blog-index container"><section class="window"><WindowHeader label="BLOG_ARCHIVE"/><div class="blog-index-content"><p class="eyebrow">directory: /blog</p><h1>Writing.</h1><p class="intro">Psychology, research, cognition, and human behaviour.</p><div class="archive-list">{posts.map(post=><a class="archive-post" href={post.url}><div><span class="archive-category">{post.category}</span><h2>{post.title}</h2><p>{post.description}</p></div><time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</time></a>)}</div></div></section></main></BaseLayout>
