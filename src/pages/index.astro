---
import BaseLayout from "../layouts/BaseLayout.astro";import Header from "../components/Header.astro";import Footer from "../components/Footer.astro";import WindowHeader from "../components/WindowHeader.astro";
const base=import.meta.env.BASE_URL;const modules=import.meta.glob("./blog/*.md",{eager:true});const posts=Object.entries(modules).map(([p,m])=>({...m.frontmatter,url:`${base}blog/${p.split('/').pop().replace('.md','')}/`})).sort((a,b)=>new Date(b.date)-new Date(a.date)).slice(0,3);
---
<BaseLayout><Header/><main id="home"><section class="window hero container"><WindowHeader label="SYSTEM_OVERVIEW"/><div class="hero-body"><div class="line-numbers" aria-hidden="true"><span>01 —</span><span>02 —</span><span>03 —</span><span>04 —</span><span>05 —</span><span>06 —</span><span>07 —</span><span>08 —</span><span>09 —</span><span>10 —</span></div><div class="hero-copy"><p class="eyebrow">status: online</p><h1>Abdalla.<span class="cursor"></span></h1><p class="role">Psychology Graduate<br>Curious Mind. Lifelong Learner.</p><p class="intro"><span>&gt;</span> Exploring mind, behaviour, and the human experience through science and writing.</p><a class="terminal-button" href="#about">&gt; view_about_me.exe</a></div><div class="hero-visual" aria-hidden="true"><div class="shape shape-a"></div><div class="shape shape-b"></div><div class="shape shape-c"></div><div class="dot-matrix"></div></div></div></section><section class="panel-grid container"><article class="window panel" id="about"><WindowHeader label="ABOUT_ME"/><div class="panel-content"><p>I am a psychology graduate with a strong interest in understanding human behaviour, cognition, and mental processes.</p><p>My interests include cognitive psychology, decision-making, research methods, and the practical application of psychological evidence.</p><p>This space is where I document what I learn, think, and explore.</p><a class="terminal-button compact" href="#blog">&gt; read_more.dat</a></div></article><article class="window panel" id="blog"><WindowHeader label="BLOG"/><div class="panel-content"><div class="post-list">{posts.map(post=><a class="post" href={post.url}><div><h2>{post.title}</h2><time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time></div><span>›</span></a>)}</div><a class="terminal-button compact" href={`${base}blog/`}>&gt; open_blog.log</a></div></article><article class="window panel" id="contact"><WindowHeader label="CONTACT"/><div class="panel-content"><p>I’m open to thoughtful conversations, professional opportunities, and collaboration.</p><ul class="contact-list"><li><span class="icon">✉</span><a href="mailto:your-email@example.com">your-email@example.com</a></li><li><span class="icon">in</span><a href="https://www.linkedin.com/">linkedin.com/in/yourprofile</a></li><li><span class="icon">⌘</span><a href="https://github.com/">github.com/yourusername</a></li><li><span class="icon">⌖</span><span>your location</span></li></ul><a class="terminal-button compact" href="mailto:your-email@example.com">&gt; send_message.exe</a></div></article></section></main><Footer/></BaseLayout>
