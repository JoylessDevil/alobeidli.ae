---
import BaseLayout from "./BaseLayout.astro";import Header from "../components/Header.astro";const {frontmatter}=Astro.props;const base=import.meta.env.BASE_URL;
---
<BaseLayout title={`${frontmatter.title} | Abdalla`} description={frontmatter.description}><Header/><main class="article-wrap container"><article class="window article-window"><div class="window-header"><span>// BLOG_ENTRY</span><a href={`${base}blog/`}>[ back ]</a></div><div class="article-content"><p class="eyebrow">{frontmatter.category}</p><h1>{frontmatter.title}</h1><p class="article-date">{new Date(frontmatter.date).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</p><slot/></div></article></main></BaseLayout>
